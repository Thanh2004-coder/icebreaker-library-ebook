# Local: leave empty so Vite proxies /api to http://localhost:8080
VITE_API_URL=

# Production (Vercel Environment Variables — must be set BEFORE build / Redeploy):
#   VITE_API_URL=https://<your-ebook-backend>.onrender.com
# No trailing slash. Do NOT use the Vercel frontend URL.
# Requests become: ${VITE_API_URL}/api/reviews/{gameId}
